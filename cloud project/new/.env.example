# ──────────────────────────────────────────────────────────
# Enterprise Security Log Analysis Platform
# Cloud Provider Configuration
# ──────────────────────────────────────────────────────────

# Cloud Provider: "local" (filesystem + SQLite) or "aws" (real AWS services)
CLOUD_PROVIDER=local

# AWS Configuration (only needed when CLOUD_PROVIDER=aws)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3 Configuration
S3_BUCKET=security-logs-bucket

# DynamoDB Configuration
DYNAMODB_TABLE_INCIDENTS=SecurityIncidents
DYNAMODB_TABLE_ANALYSIS=AnalysisHistory

# SNS Configuration
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:SecurityAlerts

# CloudWatch Configuration
CLOUDWATCH_LOG_GROUP=/security/application-logs
